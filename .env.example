# Copiez ce fichier en .env sur le serveur et remplissez chaque valeur.
JUMTOO_ENV=production
PORT=3000
BASE_URL=https://www.jumtoo.com
BRAND_NAME=Jumtoo
SUPPORT_EMAIL=support@jumtoo.com
# 32 caractères aléatoires minimum : openssl rand -base64 48
APP_SECRET=

# Stripe (Dashboard > Développeurs > Clés API ; commencez avec les clés de test sk_test_...)
STRIPE_SECRET_KEY=
# Dashboard > Développeurs > Webhooks > point de terminaison https://www.jumtoo.com/stripe/webhook
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=14
# Identifiants des prix récurrents créés dans Stripe (price_...)
STRIPE_PRICE_ESSENTIEL_MONTH=
STRIPE_PRICE_ESSENTIEL_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_ENTREPRISE_MONTH=
STRIPE_PRICE_ENTREPRISE_YEAR=

# E-mails transactionnels : resend ou brevo (laisser log pour les écrire dans data/outbox.log)
MAIL_PROVIDER=brevo
MAIL_API_KEY=
MAIL_FROM=Jumtoo <no-reply@jumtoo.com>

# Assistant IA (formules Pro et Entreprise) : clé API Anthropic, facultative
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=200
